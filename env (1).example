# Required: pairing code generated by the MCP Control Hub installer.
MCP_PAIRING_CODE=
# Optional override for the local pairing-code file.
MCP_PAIRING_FILE=
# The server defaults to locked-down mode. Set these in your MCP host config
# only when you intentionally grant these capabilities.
MCP_COMPUTER_ALLOW_SCREENSHOTS=0
MCP_COMPUTER_ALLOW_ACTIONS=0
MCP_COMPUTER_ACTION_PAUSE=0.05
